      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>The MediaPipe Authors</name>
    </developer>
  </developers>
  <dependencies>
    
<dependency>
  <groupId>androidx.lifecycle</groupId>
  <artifactId>lifecycle-runtime</artifactId>
  <version>2.10.0</version>
  <scope>compile</scope>
</dependency>


<dependency>
  <groupId>com.google.guava</groupId>
  <artifactId>guava</artifactId>
  <version>33.5.0-android</version>
  <scope>compile</scope>
</dependency>


<dependency>
  <groupId>org.jetbrains.kotlinx</groupId>
  <artifactId>kotlinx-coroutines-guava</artifactId>
  <version>1.8.0</version>
  <scope>compile</scope>
</dependency>


<dependency>
  <groupId>com.google.android.play</groupId>
  <artifactId>ai-delivery</artifactId>
  <version>0.1.1-alpha01</version>
  <scope>compile</scope>
</dependency>

  </dependencies>
</project>
